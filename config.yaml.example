# ============================================================================
# DNSProxy 完整配置示例 (v2.0)
# ============================================================================
# 本配置文件展示了所有可用功能和配置选项
# 包括：基础配置、缓存、智能预取、域名分组、上游DNS等
# ============================================================================

# ----------------------------------------------------------------------------
# 基础配置
# ----------------------------------------------------------------------------

# 监听地址（可以是多个）
listen-addrs:
  - 0.0.0.0        # 监听所有接口
  # - 127.0.0.1    # 仅本地
  # - 192.168.1.1  # 指定IP

# 监听端口（可以是多个）
listen-ports:
  - 53             # 标准DNS端口
  # - 5353         # 备用端口

# 日志级别
verbose: true      # 启用详细日志（生产环境建议false）

# ----------------------------------------------------------------------------
# 默认上游DNS服务器
# ----------------------------------------------------------------------------
# 这些是默认使用的DNS服务器，当域名不匹配任何分组时使用

upstream:
  # 国际DNS
  - 8.8.8.8        # Google DNS
  - 8.8.4.4        # Google DNS 备用
  - 1.1.1.1        # Cloudflare DNS
  - 1.0.0.1        # Cloudflare DNS 备用
  
  # 可选：使用DNS-over-HTTPS
  # - https://dns.google/dns-query
  # - https://cloudflare-dns.com/dns-query
  
  # 可选：使用DNS-over-TLS
  # - tls://dns.google
  # - tls://one.one.one.one

# ----------------------------------------------------------------------------
# 缓存配置
# ----------------------------------------------------------------------------

# 启用缓存
cache: true

# 缓存大小（条目数）
cache-size: 10000

# 最小TTL（秒）- 0表示使用DNS响应的原始TTL
cache-min-ttl: 0

# 最大TTL（秒）- 0表示使用DNS响应的原始TTL
cache-max-ttl: 0

# 可选：乐观缓存（在TTL过期后仍返回缓存，同时后台刷新）
# cache-optimistic: true

# ----------------------------------------------------------------------------
# 智能预取配置 (v2.0 - 事件驱动架构)
# ----------------------------------------------------------------------------

# 启用智能预取功能
cache-prefetch-enabled: true

# 固定阈值（秒）- 当剩余TTL小于此值时触发预取
cache-prefetch-threshold-seconds: 5

# 百分比阈值（0-100）- 当剩余TTL小于原始TTL的此百分比时触发预取
# 实际触发条件：剩余TTL < max(threshold-seconds, original-ttl * (100-threshold-percent)/100)
cache-prefetch-threshold-percent: 80

# 最大并发预取数
cache-prefetch-max-concurrent: 10

# 最小热度阈值 - 域名需要被访问多少次才加入预取队列
cache-prefetch-min-heat-threshold: 6

# 时间窗口 - 用于判断域名是否在此时间内达到热度阈值
cache-prefetch-time-window: 180s

# 重试配置
cache-prefetch-max-retries: 2              # 最大重试次数
cache-prefetch-initial-retry-delay: 1s     # 初始重试延迟（指数退避）

# 注意：v2.0已移除以下配置（不再需要）
# cache-prefetch-scan-interval: 1s              # 已移除 - 现在是事件驱动
# cache-prefetch-inactivity-check-interval: 10s # 已移除 - 使用LRU和懒惰清理

# ----------------------------------------------------------------------------
# 域名分组配置（动态路由）
# ----------------------------------------------------------------------------
# 根据域名匹配规则，将不同的域名路由到不同的上游DNS服务器

domain-groups:
  # -------------------------------------------------------------------------
  # 分组1: 中国域名 - 使用国内DNS加速
  # -------------------------------------------------------------------------
  - name: china
    enabled: true
    domain-file: china_domains.txt
    # domain-file-format: plain  # 可选：plain, dnsmasq, gfwlist, clash（默认自动检测）
    upstream:
      - 223.5.5.5      # 阿里DNS
      - 223.6.6.6      # 阿里DNS备用
      - 119.29.29.29   # 腾讯DNS
      - 119.28.28.28   # 腾讯DNS备用
    # subdomains-only: false  # 可选：是否仅匹配子域名

  # -------------------------------------------------------------------------
  # 分组2: 广告拦截 - 返回0.0.0.0或NXDOMAIN
  # -------------------------------------------------------------------------
  - name: ads
    enabled: true
    domain-file: ad_domains.txt
    upstream:
      - 0.0.0.0        # 返回无效地址（会导致超时）
      # 建议：使用专门的广告拦截DNS
      # - 94.140.14.14   # AdGuard DNS
      # - 94.140.15.15   # AdGuard DNS备用

  # -------------------------------------------------------------------------
  # 分组3: 开发/测试域名 - 使用自定义DNS
  # -------------------------------------------------------------------------
  - name: development
    enabled: false     # 默认禁用，可通过API动态启用
    domain-file: custom_domains.txt
    upstream:
      - 192.168.1.1    # 内网DNS
      - 10.0.0.1       # 备用内网DNS

  # -------------------------------------------------------------------------
  # 分组4: CDN域名 - 使用特定DNS优化
  # -------------------------------------------------------------------------
  - name: cdn
    enabled: true
    domain-file: cdn_domains.txt
    upstream:
      - 8.8.4.4        # Google DNS（对CDN友好）
      - 1.0.0.1        # Cloudflare DNS

  # -------------------------------------------------------------------------
  # 分组5: 隐私保护域名 - 使用隐私DNS
  # -------------------------------------------------------------------------
  - name: privacy
    enabled: true
    domain-file: privacy_domains.txt
    upstream:
      - 9.9.9.9        # Quad9 DNS（隐私保护）
      - 149.112.112.112 # Quad9备用

# ----------------------------------------------------------------------------
# 域名列表文件格式说明
# ----------------------------------------------------------------------------
# 支持多种格式，会自动检测：
#
# 1. Plain Text (纯文本)
#    example.com
#    test.org
#    *.cdn.example.com    # 通配符匹配
#    keyword:ad           # 关键字匹配
#
# 2. Dnsmasq Format
#    server=/example.com/8.8.8.8
#    address=/ads.com/0.0.0.0
#
# 3. GFWList (Base64编码)
#    [AutoProxy 0.2.9]
#    ! Comment
#    ||example.com
#
# 4. Clash YAML
#    payload:
#      - DOMAIN,example.com
#      - DOMAIN-SUFFIX,test.org
#      - DOMAIN-KEYWORD,ad
#
# 匹配规则：
# - 精确匹配: example.com
# - 子域名匹配: example.com (自动匹配 *.example.com)
# - 通配符匹配: *.cdn.example.com
# - 关键字匹配: keyword:ad (匹配包含"ad"的域名)

# ----------------------------------------------------------------------------
# 高级上游配置（可选）
# ----------------------------------------------------------------------------
# 如果需要更复杂的上游配置，可以使用upstream-config-file

# upstream-config-file: upstream_config.yaml

# upstream_config.yaml 示例：
# ---
# default-upstreams:
#   - 8.8.8.8
#   - 1.1.1.1
# 
# domain-upstreams:
#   - domains:
#       - example.com
#       - test.org
#     upstream:
#       - 223.5.5.5
#   
#   - domain-file: china_domains.txt
#     domain-file-format: plain
#     upstream:
#       - 119.29.29.29
#     subdomains-only: false

# ----------------------------------------------------------------------------
# 性能调优
# ----------------------------------------------------------------------------

# 最大并发goroutine数（0表示无限制）
# max-goroutines: 0

# UDP缓冲区大小
# udp-buffer-size: 4096

# TCP超时
# tcp-timeout: 10s

# ----------------------------------------------------------------------------
# 安全配置
# ----------------------------------------------------------------------------

# 拒绝ANY查询（防止DNS放大攻击）
# refuse-any: true

# 启用DNSSEC验证
# dnssec: true

# 可信代理列表（用于获取真实客户端IP）
# trusted-proxies:
#   - 127.0.0.1/8
#   - 10.0.0.0/8

# ----------------------------------------------------------------------------
# 监控和统计
# ----------------------------------------------------------------------------

# 启用统计（可选，需要额外实现）
# enable-stats: true

# 统计输出间隔
# stats-interval: 60s

# ----------------------------------------------------------------------------
# 其他配置
# ----------------------------------------------------------------------------

# 启用IPv6
# ipv6: true

# 启用EDNS客户端子网（ECS）
# edns-client-subnet: true

# ECS子网掩码
# edns-client-subnet-mask: 24

# 启用DNS64（IPv6到IPv4转换）
# dns64: false

# DNS64前缀
# dns64-prefix: 64:ff9b::/96

# ----------------------------------------------------------------------------
# 配置文件说明
# ----------------------------------------------------------------------------
# 
# 1. 基础使用
#    - 只需配置 listen-addrs, listen-ports, upstream 即可运行
#    - cache 建议启用以提高性能
#
# 2. 启用智能预取
#    - 设置 cache-prefetch-enabled: true
#    - 调整阈值参数以适应你的网络环境
#    - 热门域名会自动预取，保持缓存新鲜
#
# 3. 使用域名分组
#    - 创建域名列表文件（如 china_domains.txt）
#    - 在 domain-groups 中配置分组
#    - 可以动态启用/禁用分组（通过API）
#
# 4. 性能优化
#    - 增加 cache-size 以缓存更多域名
#    - 调整 cache-prefetch-max-concurrent 以控制并发
#    - 使用 cache-prefetch-min-heat-threshold 过滤冷门域名
#
# 5. 故障排查
#    - 设置 verbose: true 查看详细日志
#    - 检查域名列表文件是否存在
#    - 验证上游DNS服务器是否可达
#
# ----------------------------------------------------------------------------
# 配置验证
# ----------------------------------------------------------------------------
# 
# 启动前验证配置：
#   ./dnsproxy -c config.yaml --check-config
#
# 测试DNS查询：
#   dig @127.0.0.1 google.com
#   nslookup google.com 127.0.0.1
#
# 查看统计信息：
#   # 需要实现统计API
#
# ----------------------------------------------------------------------------
# 更多信息
# ----------------------------------------------------------------------------
# 
# 文档：
#   - PREFETCH_FEATURE.md - 预取功能详解
#   - DYNAMIC_DOMAIN_GROUPS.md - 域名分组详解
#   - MULTIFORMAT_DOMAIN_LISTS.md - 域名列表格式
#   - COMPREHENSIVE_TEST_GUIDE.md - 测试指南
#
# 示例配置：
#   - test-prefetch-config.yaml - 预取测试配置
#   - test_comprehensive_config.yaml - 综合测试配置
#   - upstream_config_with_files.yaml - 上游配置示例
#
# ============================================================================
