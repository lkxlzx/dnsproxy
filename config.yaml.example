# ============================================================================
# DNSProxy 完整配置示例 (v2.0)
# ============================================================================
# 本配置文件展示了所有可用功能和配置选项
# 包括：基础配置、缓存、智能预取、域名分组、上游DNS等
# ============================================================================

# ----------------------------------------------------------------------------
# 基础配置
# ----------------------------------------------------------------------------

# 监听地址（可以是多个）
listen-addrs:
  - 0.0.0.0        # 监听所有接口
  # - 127.0.0.1    # 仅本地
  # - 192.168.1.1  # 指定IP

# 监听端口（可以是多个）
listen-ports:
  - 53             # 标准DNS端口
  # - 5353         # 备用端口

# 日志级别
verbose: true      # 启用详细日志（生产环境建议false）

# ----------------------------------------------------------------------------
# 上游DNS分组配置
# ----------------------------------------------------------------------------
# 定义可重用的上游DNS服务器分组，通过ID引用，方便管理
# 支持主备模式：fallback-upstreams只在所有主要upstreams失败时使用

upstream-groups:
  # 分组1: 国内DNS（带备用）
  - id: china-dns
    description: 中国大陆DNS服务器
    upstreams:
      - 223.5.5.5      # 阿里DNS（主要）
      - 223.6.6.6      # 阿里DNS备用（主要）
      - 119.29.29.29   # 腾讯DNS（主要）
    fallback-upstreams:
      - 114.114.114.114  # 114DNS（备用，仅在主要全部失败时使用）
      - 180.76.76.76     # 百度DNS（备用）

  # 分组2: 国际DNS（带备用）
  - id: global-dns
    description: 国际DNS服务器
    upstreams:
      - 8.8.8.8        # Google DNS（主要）
      - 8.8.4.4        # Google DNS备用（主要）
    fallback-upstreams:
      - 1.1.1.1        # Cloudflare DNS（备用）
      - 1.0.0.1        # Cloudflare DNS备用（备用）

  # 分组3: 广告拦截DNS（带备用）
  - id: adblock-dns
    description: 广告拦截DNS服务器
    upstreams:
      - 94.140.14.14   # AdGuard DNS（主要）
      - 94.140.15.15   # AdGuard DNS备用（主要）
    fallback-upstreams:
      - 9.9.9.9        # Quad9（备用，也有广告拦截功能）

  # 分组4: 隐私DNS（无备用）
  - id: privacy-dns
    description: 隐私保护DNS服务器
    upstreams:
      - 9.9.9.9        # Quad9 DNS
      - 149.112.112.112 # Quad9备用
    # 不设置fallback-upstreams，表示没有备用服务器

  # 分组5: 内网DNS（带公网备用）
  - id: internal-dns
    description: 内网DNS服务器
    upstreams:
      - 192.168.1.1    # 内网DNS（主要）
      - 10.0.0.1       # 备用内网DNS（主要）
    fallback-upstreams:
      - 8.8.8.8        # 公网DNS（备用，内网DNS全部失败时使用）

# ----------------------------------------------------------------------------
# 默认上游DNS服务器（全局兜底）
# ----------------------------------------------------------------------------
# 说明：
# 1. 当域名不匹配任何分组时使用
# 2. 作为所有域名分组的最终兜底（当分组的主要+备用+默认都失败时）

# 推荐方式：使用上游分组ID
# 优势：统一管理，支持主备模式
default-upstream-group-id: global-dns  # 引用上游分组ID

# 备用方式：直接指定DNS服务器
# 作为最终兜底，在以下情况生效：
#   1. 没有设置default-upstream-group-id时，作为未匹配域名的默认DNS
#   2. default-upstream-group-id指定的分组不存在时
#   3. default-upstream-group-id的主要和备用DNS全部失效时
#   4. 域名分组的主要和备用DNS全部失效时（对所有域名生效）
upstream:
  - 8.8.8.8        # Google DNS（最终兜底）
  - 8.8.4.4        # Google DNS 备用
  - 1.1.1.1        # Cloudflare DNS
  - 1.0.0.1        # Cloudflare DNS 备用
# ----------------------------------------------------------------------------
# 缓存配置
# ----------------------------------------------------------------------------

# 启用缓存
cache: true

# 缓存大小（条目数）
cache-size: 10000

# 最小TTL（秒）- 0表示使用DNS响应的原始TTL
cache-min-ttl: 0

# 最大TTL（秒）- 0表示使用DNS响应的原始TTL
cache-max-ttl: 0

# 可选：乐观缓存（在TTL过期后仍返回缓存，同时后台刷新）
# cache-optimistic: true

# ----------------------------------------------------------------------------
# 智能预取配置 (v2.0 - 事件驱动架构)
# ----------------------------------------------------------------------------

# 启用智能预取功能
cache-prefetch-enabled: true

# 固定阈值（秒）- 当剩余TTL小于此值时触发预取
cache-prefetch-threshold-seconds: 5

# 百分比阈值（0-100）- 当剩余TTL小于原始TTL的此百分比时触发预取
# 实际触发条件：剩余TTL < max(threshold-seconds, original-ttl * (100-threshold-percent)/100)
cache-prefetch-threshold-percent: 80

# 最大并发预取数
cache-prefetch-max-concurrent: 10

# 最小热度阈值 - 域名需要被访问多少次才加入预取队列
cache-prefetch-min-heat-threshold: 6

# 时间窗口 - 用于判断域名是否在此时间内达到热度阈值
cache-prefetch-time-window: 180s

# 重试配置
cache-prefetch-max-retries: 2              # 最大重试次数
cache-prefetch-initial-retry-delay: 1s     # 初始重试延迟（指数退避）

# 注意：v2.0已移除以下配置（不再需要）
# cache-prefetch-scan-interval: 1s              # 已移除 - 现在是事件驱动
# cache-prefetch-inactivity-check-interval: 10s # 已移除 - 使用LRU和懒惰清理

# ----------------------------------------------------------------------------
# 域名分组配置（动态路由）v2.0
# ----------------------------------------------------------------------------
# 根据域名匹配规则，将不同的域名路由到不同的上游DNS服务器
# 新功能：
#   - 使用upstream-group-id引用上游分组（推荐）
#   - 支持从URL自动下载域名列表
#   - 支持定时自动更新
#   - 显示域名数量和更新时间

domain-groups:
  # -------------------------------------------------------------------------
  # 分组1: 中国域名 - 使用国内DNS加速（从URL自动更新）
  # -------------------------------------------------------------------------
  - name: china
    enabled: true
    
    # 本地文件路径（用作缓存）
    domain-file: china_domains.txt
    
    # 远程URL（可选，用于自动更新）
    domain-file-url: https://raw.githubusercontent.com/felixonmars/dnsmasq-china-list/master/accelerated-domains.china.conf
    
    # 自动更新间隔（可选，0或不设置表示不自动更新）
    update-interval: 24h  # 每24小时更新一次
    
    # domain-file-format: dnsmasq  # 可选：plain, dnsmasq, gfwlist, clash（默认自动检测）
    
    # 使用上游分组ID（推荐方式）
    upstream-group-id: china-dns
    
    # 或者直接指定上游（当upstream-group-id为空时使用）
    # upstream:
    #   - 223.5.5.5
    #   - 119.29.29.29
    
    # subdomains-only: false  # 可选：是否仅匹配子域名

  # -------------------------------------------------------------------------
  # 分组2: 广告拦截 - 使用广告拦截DNS（从URL自动更新）
  # -------------------------------------------------------------------------
  - name: ads
    enabled: true
    domain-file: ad_domains.txt
    domain-file-url: https://raw.githubusercontent.com/privacy-protection-tools/anti-AD/master/anti-ad-domains.txt
    update-interval: 12h  # 每12小时更新一次
    upstream-group-id: adblock-dns

  # -------------------------------------------------------------------------
  # 分组3: GFWList - 使用国际DNS（从URL自动更新）
  # -------------------------------------------------------------------------
  - name: gfwlist
    enabled: true
    domain-file: gfw_domains.txt
    domain-file-url: https://raw.githubusercontent.com/gfwlist/gfwlist/master/gfwlist.txt
    domain-file-format: gfwlist  # GFWList格式（Base64编码）
    update-interval: 168h  # 每7天更新一次
    upstream-group-id: global-dns

  # -------------------------------------------------------------------------
  # 分组4: 开发/测试域名 - 使用自定义DNS（本地文件，带公网备用）
  # -------------------------------------------------------------------------
  - name: development
    enabled: false     # 默认禁用，可通过API动态启用
    domain-file: custom_domains.txt
    # 不设置URL，仅使用本地文件
    upstream-group-id: internal-dns  # 使用内网DNS分组（已包含备用）

  # -------------------------------------------------------------------------
  # 分组5: CDN域名 - 完整的三层故障转移示例
  # -------------------------------------------------------------------------
  - name: cdn
    enabled: true
    domain-file: cdn_domains.txt
    # 直接配置三层故障转移
    upstream:
      - 8.8.4.4        # Google DNS（主要，第1层）
      - 8.8.8.8        # Google DNS备用（主要，第1层）
    fallback-upstream:
      - 1.1.1.1        # Cloudflare DNS（备用，第2层，主要全部失败时使用）
      - 1.0.0.1        # Cloudflare DNS备用（备用，第2层）
    default-upstream-group-id: china-dns  # 默认兜底（第3层，备用也失败时使用）

  # -------------------------------------------------------------------------
  # 分组6: 隐私保护域名 - 使用分组ID的三层故障转移
  # -------------------------------------------------------------------------
  - name: privacy
    enabled: true
    domain-file: privacy_domains.txt
    upstream-group-id: privacy-dns  # 主要+备用（第1层+第2层，来自分组）
    default-upstream-group-id: global-dns  # 默认兜底（第3层）

# ----------------------------------------------------------------------------
# 故障转移机制说明
# ----------------------------------------------------------------------------
# DNSProxy支持完整的三层故障转移机制，确保DNS查询的高可用性
#
# === 核心概念 ===
# 
# upstream (全局兜底): 对所有域名生效的最终兜底DNS（无论是否匹配域名分组）
# default-upstream-group-id: 仅对未匹配任何域名分组的域名生效
#
# === 对于匹配到域名分组的查询 ===
#
# 第1层：分组主要上游 (upstreams 或 upstream-group-id的upstreams)
#   └─ 该分组优先使用的DNS服务器
#   └─ 全部失败 ↓
#
# 第2层：分组备用上游 (fallback-upstreams 或 upstream-group-id的fallback-upstreams)
#   └─ 只有当第1层全部失败时才使用
#   └─ 全部失败 ↓
#
# 第3层：全局upstream（全局兜底）
#   └─ 只有当第1层和第2层都失败时才使用
#   └─ 对所有域名生效，无论是否匹配分组
#   └─ 全部失败 ↓
#
# ❌ 返回DNS查询失败
#
# === 对于未匹配任何域名分组的查询 ===
#
# 第1层：全局默认上游分组 (default-upstream-group-id的upstreams)
#   └─ 使用指定分组的主要上游
#   └─ 全部失败 ↓
#
# 第2层：全局默认上游分组的备用 (default-upstream-group-id的fallback-upstreams)
#   └─ 使用指定分组的备用上游
#   └─ 全部失败 ↓
#
# 第3层：全局upstream（全局兜底）
#   └─ 只有当第1层和第2层都失败时才使用
#   └─ 全部失败 ↓
#
# ❌ 返回DNS查询失败
#
# === 查询流程示例 ===
#
# 示例1：匹配到china域名分组的查询（如baidu.com）
#   1️⃣ 第1层：主要上游
#      └─ china分组的upstreams: [223.5.5.5, 223.6.6.6, 119.29.29.29]
#      └─ 全部失败 ↓
#   
#   2️⃣ 第2层：备用上游
#      └─ china分组的fallback-upstreams: [114.114.114.114, 180.76.76.76]
#      └─ 全部失败 ↓
#   
#   3️⃣ 第3层：全局upstream（最终兜底）
#      └─ 全局upstream: [8.8.8.8, 1.1.1.1]
#      └─ 全部失败 ↓
#   
#   ❌ 返回DNS查询失败
#
# 示例2：未匹配任何域名分组的查询（如example.com）
#   1️⃣ 第1层：默认分组主要上游
#      └─ default-upstream-group-id (global-dns)的upstreams: [8.8.8.8, 8.8.4.4]
#      └─ 全部失败 ↓
#   
#   2️⃣ 第2层：默认分组备用上游
#      └─ global-dns的fallback-upstreams: [1.1.1.1, 1.0.0.1]
#      └─ 全部失败 ↓
#   
#   3️⃣ 第3层：全局upstream（最终兜底）
#      └─ 全局upstream: [8.8.8.8, 1.1.1.1]
#      └─ 全部失败 ↓
#   
#   ❌ 返回DNS查询失败
#
# === 配置建议 ===
#
# 1. 推荐配置方式：
#    - 使用upstream-groups定义可重用的DNS服务器分组
#    - 在domain-groups中通过upstream-group-id引用分组
#    - 设置default-upstream-group-id作为未匹配域名的默认分组
#    - 设置upstream作为所有域名的最终兜底
#
# 2. 简化配置方式：
#    - 直接在domain-groups中配置upstream和fallback-upstream
#    - 设置upstream作为全局兜底
#
# 3. 最小配置方式：
#    - 只配置upstream（所有域名都使用同一组DNS）
#
# === 配置示例 ===
#
#   # 全局兜底（对所有域名生效，最终兜底）
#   upstream: [8.8.8.8, 1.1.1.1]
#
#   # 未匹配域名的默认分组（仅对未匹配域名生效）
#   default-upstream-group-id: global-dns
#
#   domain-groups:
#     - name: china
#       upstream-group-id: china-dns  # 引用分组（包含主要+备用）
#       # 第1层: china-dns的upstreams
#       # 第2层: china-dns的fallback-upstreams
#       # 第3层: 全局upstream

# ----------------------------------------------------------------------------
# 域名列表文件格式说明
# ----------------------------------------------------------------------------
# 支持多种格式，会自动检测：
#
# 1. Plain Text (纯文本)
#    example.com
#    test.org
#    *.cdn.example.com    # 通配符匹配
#    keyword:ad           # 关键字匹配
#
# 2. Dnsmasq Format
#    server=/example.com/8.8.8.8
#    address=/ads.com/0.0.0.0
#
# 3. GFWList (Base64编码)
#    [AutoProxy 0.2.9]
#    ! Comment
#    ||example.com
#
# 4. Clash YAML
#    payload:
#      - DOMAIN,example.com
#      - DOMAIN-SUFFIX,test.org
#      - DOMAIN-KEYWORD,ad
#
# 匹配规则：
# - 精确匹配: example.com
# - 子域名匹配: example.com (自动匹配 *.example.com)
# - 通配符匹配: *.cdn.example.com
# - 关键字匹配: keyword:ad (匹配包含"ad"的域名)

# ----------------------------------------------------------------------------
# 高级上游配置（可选）
# ----------------------------------------------------------------------------
# 如果需要更复杂的上游配置，可以使用upstream-config-file

# upstream-config-file: upstream_config.yaml

# upstream_config.yaml 示例：
# ---
# default-upstreams:
#   - 8.8.8.8
#   - 1.1.1.1
# 
# domain-upstreams:
#   - domains:
#       - example.com
#       - test.org
#     upstream:
#       - 223.5.5.5
#   
#   - domain-file: china_domains.txt
#     domain-file-format: plain
#     upstream:
#       - 119.29.29.29
#     subdomains-only: false

# ----------------------------------------------------------------------------
# 性能调优
# ----------------------------------------------------------------------------

# 最大并发goroutine数（0表示无限制）
# max-goroutines: 0

# UDP缓冲区大小
# udp-buffer-size: 4096

# TCP超时
# tcp-timeout: 10s

# ----------------------------------------------------------------------------
# 安全配置
# ----------------------------------------------------------------------------

# 拒绝ANY查询（防止DNS放大攻击）
# refuse-any: true

# 启用DNSSEC验证
# dnssec: true

# 可信代理列表（用于获取真实客户端IP）
# trusted-proxies:
#   - 127.0.0.1/8
#   - 10.0.0.0/8

# ----------------------------------------------------------------------------
# 监控和统计
# ----------------------------------------------------------------------------

# 启用统计（可选，需要额外实现）
# enable-stats: true

# 统计输出间隔
# stats-interval: 60s

# ----------------------------------------------------------------------------
# 其他配置
# ----------------------------------------------------------------------------

# 启用IPv6
# ipv6: true

# 启用EDNS客户端子网（ECS）
# edns-client-subnet: true

# ECS子网掩码
# edns-client-subnet-mask: 24

# 启用DNS64（IPv6到IPv4转换）
# dns64: false

# DNS64前缀
# dns64-prefix: 64:ff9b::/96

# ----------------------------------------------------------------------------
# 配置文件说明
# ----------------------------------------------------------------------------
# 
# 1. 基础使用
#    - 只需配置 listen-addrs, listen-ports, upstream 即可运行
#    - cache 建议启用以提高性能
#
# 2. 启用智能预取
#    - 设置 cache-prefetch-enabled: true
#    - 调整阈值参数以适应你的网络环境
#    - 热门域名会自动预取，保持缓存新鲜
#
# 3. 使用域名分组
#    - 创建域名列表文件（如 china_domains.txt）
#    - 在 domain-groups 中配置分组
#    - 可以动态启用/禁用分组（通过API）
#
# 4. 性能优化
#    - 增加 cache-size 以缓存更多域名
#    - 调整 cache-prefetch-max-concurrent 以控制并发
#    - 使用 cache-prefetch-min-heat-threshold 过滤冷门域名
#
# 5. 故障排查
#    - 设置 verbose: true 查看详细日志
#    - 检查域名列表文件是否存在
#    - 验证上游DNS服务器是否可达
#
# ----------------------------------------------------------------------------
# 配置验证
# ----------------------------------------------------------------------------
# 
# 启动前验证配置：
#   ./dnsproxy -c config.yaml --check-config
#
# 测试DNS查询：
#   dig @127.0.0.1 google.com
#   nslookup google.com 127.0.0.1
#
# 查看统计信息：
#   # 需要实现统计API
#
# ----------------------------------------------------------------------------
# 更多信息
# ----------------------------------------------------------------------------
# 
# 文档：
#   - PREFETCH_FEATURE.md - 预取功能详解
#   - DYNAMIC_DOMAIN_GROUPS.md - 域名分组详解
#   - MULTIFORMAT_DOMAIN_LISTS.md - 域名列表格式
#   - COMPREHENSIVE_TEST_GUIDE.md - 测试指南
#
# 示例配置：
#   - test-prefetch-config.yaml - 预取测试配置
#   - test_comprehensive_config.yaml - 综合测试配置
#   - upstream_config_with_files.yaml - 上游配置示例
#
# ============================================================================
