# DNSProxy Upstream Groups with Domain File Loading
# 支持从文件和 URL 加载域名列表

listen-addrs:
  - "0.0.0.0"
listen-ports:
  - 53
cache: true

upstream-groups:
  default_group: "global"
  
  groups:
    # 全球 DNS
    - name: "global"
      upstreams:
        - "1.1.1.1"
        - "8.8.8.8"
    
    # 中国 DNS
    - name: "china"
      upstreams:
        - "223.5.5.5"
        - "119.29.29.29"
    
    # 本地 DNS
    - name: "local"
      upstreams:
        - "192.168.1.1"
  
  # 域名到组的映射
  # 支持两种方式:
  # 1. 直接映射: 域名模式 -> 组名
  # 2. 文件加载: 组名 -> 文件路径或URL (系统自动检测)
  domain_groups:
    # 方式 1: 直接指定域名到组的映射
    "example.com": "global"
    "*.example.com": "global"
    
    # 方式 2: 从本地文件加载域名列表 (组名: 文件路径)
    "china": "/etc/dnsproxy/domains/china.txt"
    "local": "./domains/local.yaml"
    "ads": "./domains/adblock.txt"
    
    # 方式 3: 从远程 URL 加载域名列表 (组名: URL)
    # Clash 格式 (YAML)
    # "china": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/ChinaMax/ChinaMax_Classical.yaml"
    
    # GFWList 格式 (base64 编码)
    # "gfw": "https://raw.githubusercontent.com/gfwlist/gfwlist/refs/heads/master/gfwlist.txt"

# 支持的文件格式:
#
# 1. 纯文本格式 (每行一个域名)
#    example.com
#    *.google.com
#    test.local
#
# 2. Clash YAML 格式
#    payload:
#      - DOMAIN,example.com
#      - DOMAIN-SUFFIX,google.com
#      - DOMAIN-KEYWORD,youtube
#
# 3. GFWList 格式 (base64 编码)
#    [AutoProxy 0.2.9]
#    base64_encoded_content...
#
# 4. 带注释的文本格式
#    # 这是注释
#    example.com
#    ! 这也是注释
#    test.com

# 域名文件示例:
#
# china.txt (纯文本):
# ---
# baidu.com
# *.taobao.com
# qq.com
# weixin.com
# ---
#
# local.yaml (Clash 格式):
# ---
# payload:
#   - DOMAIN,internal.company.com
#   - DOMAIN-SUFFIX,corp.local
#   - DOMAIN,intranet.local
# ---

# 使用场景:
#
# 1. 中国域名分流
#    - 中国域名使用国内 DNS
#    - 其他域名使用国际 DNS
#
# 2. 广告过滤
#    - 广告域名使用特定 DNS 或拦截
#
# 3. 内网域名
#    - 内网域名使用内网 DNS
#
# 4. GFW 翻墙
#    - 被墙域名使用代理 DNS

# 注意事项:
#
# 1. 文件路径
#    - 绝对路径: /etc/dnsproxy/domains/china.txt
#    - 相对路径: ./domains/china.txt
#    - URL: https://example.com/domains.txt
#
# 2. 文件格式自动检测
#    - 根据文件扩展名 (.yaml, .yml)
#    - 根据文件内容特征
#    - 支持多种格式混用
#
# 3. 性能考虑
#    - 域名列表会在启动时加载
#    - 大文件可能影响启动时间
#    - 建议使用缓存减少查询
#
# 4. 更新策略
#    - 启用动态重载自动更新
#    - 或手动触发重载
#
# 5. 错误处理
#    - 文件加载失败会记录错误
#    - 不会影响其他域名映射
#    - 建议监控日志

# 动态重载配置 (可选)
reload:
  enabled: true
  watch_file: "config-groups-domains.yaml.example"
  check_interval: "3600s"  # 每小时检查一次

# 健康检查 (推荐)
health-check:
  enabled: true
  interval: "30s"

# 统计信息 (推荐)
statistics:
  enabled: true

# HTTP API (可选)
api:
  enabled: true
  listen_addr: "127.0.0.1:8080"
