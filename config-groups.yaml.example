# DNSProxy Upstream Groups Configuration Example
# This file demonstrates how to configure upstream server groups

# Basic configuration
listen-addrs:
  - "0.0.0.0"
listen-ports:
  - 53
dnssec: true
cache: true
timeout: '10s'

# Upstream Groups Configuration
upstream-groups:
  # Default group to use when no specific group matches
  default_group: "primary"
  
  # Define upstream groups
  groups:
    # Primary group - fast public DNS servers
    - name: "primary"
      enabled: true
      mode: "load_balance"  # Options: load_balance, parallel, fastest_addr
      timeout: "5s"
      max_retries: 2
      priority: 1
      upstreams:
        - "1.1.1.1:53"
        - "8.8.8.8:53"
        - "8.8.4.4:53"
    
    # Secure group - encrypted DNS servers
    - name: "secure"
      enabled: true
      mode: "parallel"
      timeout: "10s"
      max_retries: 3
      priority: 2
      upstreams:
        - "tls://dns.adguard.com"
        - "https://dns.google/dns-query"
        - "quic://dns.adguard.com"
    
    # Local group - for internal domains
    - name: "local"
      enabled: true
      mode: "load_balance"
      timeout: "3s"
      max_retries: 1
      priority: 1
      upstreams:
        - "192.168.1.1:53"
        - "192.168.1.2:53"
    
    # Fast group - optimized for speed
    - name: "fast"
      enabled: true
      mode: "fastest_addr"
      timeout: "5s"
      max_retries: 2
      priority: 1
      upstreams:
        - "1.1.1.1"
        - "1.0.0.1"
        - "8.8.8.8"
        - "8.8.4.4"
    
    # Backup group - fallback servers
    - name: "backup"
      enabled: true
      mode: "load_balance"
      timeout: "15s"
      max_retries: 5
      priority: 10
      upstreams:
        - "9.9.9.9:53"
        - "149.112.112.112:53"
  
  # Map specific domains to groups
  domain_groups:
    # Internal domains use local DNS
    "internal.local": "local"
    "corp.local": "local"
    "*.internal.local": "local"
    
    # Sensitive domains use secure group
    "banking.com": "secure"
    "*.banking.com": "secure"
    "secure.example.com": "secure"
    
    # CDN domains use fast group
    "cdn.example.com": "fast"
    "*.cdn.cloudflare.com": "fast"
    
    # Everything else uses primary group (default)

# Alternative: Simple text-based configuration
# You can also use a simple text format in a separate file:
# upstream-groups-file: "groups.txt"

# Example groups.txt format:
# [group:primary:load_balance:5s]
# 1.1.1.1
# 8.8.8.8
# 
# [group:secure:parallel:10s]
# tls://dns.adguard.com
# https://dns.google/dns-query
# 
# [/internal.local/corp.local/]local
# [default]primary
