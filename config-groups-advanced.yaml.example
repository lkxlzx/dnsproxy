# DNSProxy Advanced Upstream Groups Configuration
# This file demonstrates all advanced features including health checks,
# statistics, dynamic reload, and HTTP API

# Basic DNS configuration
listen-addrs:
  - "0.0.0.0"
listen-ports:
  - 53
dnssec: true
cache: true
cache-min-ttl: 300
timeout: '10s'

# Upstream Groups Configuration
upstream-groups:
  # Default group
  default_group: "primary"
  
  # Define upstream groups
  groups:
    # Primary group with health checking
    - name: "primary"
      enabled: true
      mode: "load_balance"
      timeout: "5s"
      max_retries: 2
      priority: 1
      upstreams:
        - "1.1.1.1:53"
        - "8.8.8.8:53"
        - "8.8.4.4:53"
    
    # Secure group with parallel queries
    - name: "secure"
      enabled: true
      mode: "parallel"
      timeout: "10s"
      max_retries: 3
      priority: 2
      upstreams:
        - "tls://dns.adguard.com"
        - "https://dns.google/dns-query"
        - "quic://dns.adguard.com"
    
    # Local group for internal domains
    - name: "local"
      enabled: true
      mode: "load_balance"
      timeout: "3s"
      max_retries: 1
      priority: 1
      upstreams:
        - "192.168.1.1:53"
        - "192.168.1.2:53"
    
    # Fast group with fastest address selection
    - name: "fast"
      enabled: true
      mode: "fastest_addr"
      timeout: "5s"
      max_retries: 2
      priority: 1
      upstreams:
        - "1.1.1.1"
        - "1.0.0.1"
        - "8.8.8.8"
        - "8.8.4.4"
    
    # Backup group for failover
    - name: "backup"
      enabled: true
      mode: "load_balance"
      timeout: "15s"
      max_retries: 5
      priority: 10
      upstreams:
        - "9.9.9.9:53"
        - "149.112.112.112:53"
        - "208.67.222.222:53"
  
  # Domain to group mappings
  domain_groups:
    # Internal domains
    "internal.local": "local"
    "corp.local": "local"
    "*.internal.local": "local"
    
    # Secure domains
    "banking.com": "secure"
    "*.banking.com": "secure"
    "secure.example.com": "secure"
    "*.secure.example.com": "secure"
    
    # Fast domains (CDN)
    "cdn.example.com": "fast"
    "*.cdn.cloudflare.com": "fast"
    "static.example.com": "fast"

# Health Check Configuration
health-check:
  enabled: true
  interval: "30s"           # Check every 30 seconds
  timeout: "5s"             # Timeout for each check
  failure_threshold: 3      # Mark unhealthy after 3 failures
  success_threshold: 2      # Mark healthy after 2 successes
  test_domain: "dns.google." # Domain to query for health checks

# Statistics Collection
statistics:
  enabled: true
  # Statistics are collected automatically for all groups

# Dynamic Configuration Reload
reload:
  enabled: true
  watch_file: "config-groups-advanced.yaml.example"
  check_interval: "30s"     # Check for changes every 30 seconds

# HTTP API Configuration
api:
  enabled: true
  listen_addr: "127.0.0.1:8080"
  read_timeout: "10s"
  write_timeout: "10s"
  auth_token: "your-secret-token-here"  # Optional bearer token

# API Endpoints:
# GET  /api/v1/status              - Server status
# GET  /api/v1/groups              - List all groups
# GET  /api/v1/groups/{name}       - Get specific group info
# GET  /api/v1/stats               - Get all statistics
# GET  /api/v1/stats/{group}       - Get group statistics
# GET  /api/v1/health              - Get all health status
# GET  /api/v1/health/{address}    - Get upstream health status
# POST /api/v1/reload              - Trigger configuration reload

# Example API Usage:
# curl http://127.0.0.1:8080/api/v1/status
# curl http://127.0.0.1:8080/api/v1/groups
# curl http://127.0.0.1:8080/api/v1/stats
# curl http://127.0.0.1:8080/api/v1/health
# curl -X POST http://127.0.0.1:8080/api/v1/reload

# With authentication:
# curl -H "Authorization: Bearer your-secret-token-here" \
#      http://127.0.0.1:8080/api/v1/groups

# Advanced Features Summary:
# 
# 1. Health Checking
#    - Automatic health monitoring of all upstreams
#    - Configurable check intervals and thresholds
#    - Unhealthy upstreams are automatically excluded
#    - Detailed health statistics available via API
#
# 2. Statistics Collection
#    - Per-group query statistics
#    - Per-upstream statistics
#    - Success/failure rates
#    - Average latency tracking
#    - Available via API
#
# 3. Dynamic Reload
#    - Automatic configuration reload on file changes
#    - Manual reload via API
#    - Zero-downtime configuration updates
#    - Validation before applying changes
#
# 4. HTTP API
#    - RESTful API for management
#    - Query statistics and health status
#    - Trigger manual reloads
#    - Optional authentication
#
# 5. Weighted Load Balancing
#    - Assign weights to upstreams (future)
#    - Intelligent traffic distribution
#    - Based on performance metrics
#
# 6. Conditional Routing
#    - Route based on client IP (future)
#    - Time-based routing (future)
#    - Geographic routing (future)

# Performance Tuning:
# - Use health checks to avoid slow upstreams
# - Monitor statistics to identify bottlenecks
# - Adjust timeouts based on latency data
# - Use fastest_addr mode for CDN domains
# - Enable caching to reduce upstream load

# Monitoring:
# - Check /api/v1/health for upstream status
# - Monitor /api/v1/stats for performance metrics
# - Set up alerts based on failure rates
# - Track average latency trends

# Best Practices:
# 1. Enable health checks in production
# 2. Use statistics to optimize configuration
# 3. Set appropriate timeouts and retries
# 4. Use secure authentication for API
# 5. Monitor health and statistics regularly
# 6. Test configuration before reload
# 7. Keep backup groups configured
